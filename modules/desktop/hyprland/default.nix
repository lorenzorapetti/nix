{
  den,
  lib,
  ...
}: {
  den.aspects.desktop.hyprland = {
    includes = with den.aspects; [
      desktop
      desktop.wm
      desktop.base-applications
      desktop.wm-applications
      desktop.wlr-which-key
      desktop.noctalia
    ];

    nixos = {pkgs, ...}: {
      environment.systemPackages = with pkgs; [
        runapp
        hyprmoncfg
      ];

      programs.hyprland = {
        enable = true;
        withUWSM = true;
      };
    };

    homeManager = {
      pkgs,
      config,
      osConfig,
      inputs',
      ...
    }: {
      home.sessionVariables = {
        QT_WAYLAND_DISABLE_WINDOWDECORATION = "1";
        ELECTRON_OZONE_PLATFORM_HINT = "auto";

        # Toolkit backends per https://wiki.hypr.land/configuring/core/environment-variables/#gui-toolkits-backend
        GDK_BACKEND = "wayland,x11,*";
        QT_QPA_PLATFORM = "wayland;xcb";
        CLUTTER_BACKEND = "wayland";
        # SDL_VIDEODRIVER=wayland is intentionally unset: games bundling older
        # SDL2 versions break with it, and modern SDL picks Wayland on its own.

        UWSM_MANAGED = "1";
      };

      xdg.configFile."uwsm/env".source = "${config.home.sessionVariablesPackage}/etc/profile.d/hm-session-vars.sh";

      wayland.windowManager.hyprland = {
        enable = true;
        systemd.enable = false;
        systemd.enableXdgAutostart = true;
        xwayland.enable = true;

        # set the Hyprland and XDPH packages to null to use the ones from the NixOS module
        package = null;
        portalPackage = null;

        configType = "lua";
        extraLuaFiles = {
          "input" = ./config/input.lua;
          "keybinds" = ./config/keybinds.lua;
          "rules" = ./config/rules.lua;
          "style" = ./config/style.lua;
          "fonts" = {
            autoLoad = false;
            content = ''
              return {
                serif = "${osConfig.fonts.serif}",
                sans = "${osConfig.fonts.sans}",
                mono = "${osConfig.fonts.mono}",
                nerd = "${osConfig.fonts.nerd}",
              }
            '';
          };
          "programs" = {
            autoLoad = false;
            content = ''
              return {
                _1password = "${lib.getExe pkgs._1password-gui}",
                terminal = "${lib.getExe osConfig.defaultTerminal.package}",
                browser = "${lib.getExe pkgs.helium}",
                file_manager = "${lib.getExe pkgs.nautilus}",
                yazi = "${lib.getExe pkgs.yazi}",
                bluetui = "${lib.getExe pkgs.bluetui}",
                wiremix = "${lib.getExe pkgs.wiremix}",
                quick_terminal = "${lib.getExe osConfig.defaultTerminal.quickTerminal}",
                runapp = "${lib.getExe pkgs.runapp}",
                wlr_which_key = "${lib.getExe pkgs.wlr-which-key}",
                syzygy = "${lib.getExe inputs'.syzygy.packages.default}",
              }
            '';
          };
        };
        extraConfig = ''
          require("colors")

          -- monitors.lua is generated by hyprmoncfg, so it may not exist yet
          require("monitors")
        '';
      };

      programs.hyprland-qt-support.enable = true;

      systemd.user.services.hyprmoncfgd = {
        Unit = {
          Description = "Hyprland monitor profile daemon (hyprmoncfgd)";
          After = [config.wayland.systemd.target];
          PartOf = [config.wayland.systemd.target];
        };
        Service = {
          Type = "simple";
          ExecStart = lib.getExe' pkgs.hyprmoncfg "hyprmoncfgd";
          Restart = "on-failure";
          RestartSec = 2;
        };
        Install.WantedBy = [config.wayland.systemd.target];
      };
    };
  };
}
